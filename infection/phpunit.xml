<?xml version="1.0" encoding="UTF-8"?>
<!-- The unit suite for the Mautic stack (the plugin's own phpunit.xml needs the Mautic monorepo). Run from the plugin folder:
     php /var/www/html/vendor/bin/phpunit -c infection/phpunit.xml -->
<phpunit bootstrap="bootstrap.php" colors="false">
  <testsuites>
    <testsuite name="unit">
      <directory>../Tests/Unit</directory>
      <exclude>../Tests/Unit/Controller/CustomField/AbstractFieldControllerTest.php</exclude>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>../Model</directory>
      <directory>../EventListener</directory>
      <directory>../Helper</directory>
      <directory>../Segment</directory>
      <directory>../CustomFieldType</directory>
      <directory>../Provider</directory>
      <directory>../DTO</directory>
      <directory>../Repository</directory>
    </include>
  </source>
</phpunit>
