{% set customFieldEntity = customField.vars.data %}
{#{% set customField.vars.index = customField.vars.name %}#}
{% set order = customField.vars.value.getOrder() %}
{#{{ dump(app.request.) }}#}
{# TODO !!!!!!!!!!!! Handle deleted objects#}
{#{% set requestCustomObject = app.request.post('custom_object') %}#}
{#{% set displayStyle = requestCustomObject['customFields'][order]['deleted'] is empty ? '' : 'style="display:none;"' %}#}
{% set displayStyle = '' %}
{% set panelId = panelId is empty ? customField.vars.value.getOrder()|number_format : panelId %}
{% set routeForm = constant('MauticPlugin\\CustomObjectsBundle\\Provider\\CustomFieldRouteProvider::ROUTE_FORM') %}

<div class="panel form-field-wrapper ui-sortable-handle" id="customField_{{ panelId }}" {{ displayStyle }}>
    {# Same buttons as the form builder of core (FormBundle Builder/_actions): ghost, small, icon only, ri icons. The script
       (co-form.js) finds the edit one by `button.btn-edit` and the delete one by [data-hide-panel]. #}
    <div class="form-buttons btn-group" role="group" aria-label="Field options">
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    variant: 'ghost',
                    label: 'mautic.core.form.edit',
                    icon_only: true,
                    icon: 'ri-edit-line ri-lg text-primary',
                    size: 'md',
                    attributes: {
                        'type': 'button',
                        'data-toggle': 'ajaxmodal',
                        'data-target': '#objectFieldModal',
                        'href': path(routeForm, {
                            'fieldId': customFieldEntity.getId(),
                            'objectId': customObject.getId(),
                            'fieldType': customFieldEntity.getTypeObject().getKey()
                        }),
                        'class': 'btn-edit'
                    }
                }
            ]
        } %}
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    variant: 'ghost',
                    label: 'mautic.core.form.delete',
                    danger: true,
                    icon_only: true,
                    icon: 'ri-delete-bin-line ri-lg text-danger',
                    size: 'md',
                    attributes: {
                        'type': 'button',
                        'data-hide-panel': 'true',
                        'data-message': 'custom.field.delete.confirm'|trans({'%name%': customFieldEntity.getLabel()}),
                        'data-confirm-text': 'mautic.core.form.delete'|trans,
                        'data-confirm-callback': 'customObjectsDeleteField',
                        'data-cancel-text': 'mautic.core.form.cancel'|trans
                    }
                }
            ]
        } %}
    </div>

    <div class="row ml-0 mr-0">
        <div class="mauticform-row">
            <div class="col-xs-10">
                {{ form_row(customField.defaultValue) }}
            </div>
        </div>
    </div>
    <div class="hidden-fields">
        {{ form_rest(customField) }}
    </div>
    <div class="panel-footer">
        <i class="fa fa-cog" aria-hidden="true"></i>
        <span class="inline-spacer">
        {{ customFieldEntity.getTypeObject().getName() }}
    </span>
    </div>
</div>