{% set tableAlias = constant('MauticPlugin\\CustomObjectsBundle\\Entity\\CustomObject::TABLE_ALIAS') %}
{% set routeView = constant('MauticPlugin\\CustomObjectsBundle\\Provider\\CustomObjectRouteProvider::ROUTE_VIEW') %}
{% set routeDetails = constant('MauticPlugin\\CustomObjectsBundle\\Provider\\CustomObjectRouteProvider::ROUTE_DETAILS') %}
{% set routeList = constant('MauticPlugin\\CustomObjectsBundle\\Provider\\CustomObjectRouteProvider::ROUTE_LIST') %}

{% if items|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered" id="custom-objects-table">
            <thead>
            <tr>
                {{ include('@MauticCore/Helper/tableheader.html.twig', {
                    'checkall': 'true',
                    'target': '#custom-objects-table',
                    'langVar': 'custom.object',
                    'routeBase': 'custom_object',
                    'routeBase': 'form'
                }) }}

                <th class="col-custom-status pa-0" scope="col">
                    <span class="btn btn-ghost btn-block jc-space-between" style="pointer-events: none; color: inherit;"><span class="fw-b">{{ 'custom.object.status.column'|trans }}</span></span>
                </th>

                {{ include('@MauticCore/Helper/tableheader.html.twig', {
                    'sessionVar': sessionVar,
                    'orderBy': tableAlias~'.namePlural',
                    'text': 'mautic.core.name',
                    'class': 'col-custom_object_-name'
                }) }}

                {{ include('@MauticCore/Helper/tableheader.html.twig', {
                    'sessionVar': sessionVar,
                    'orderBy': tableAlias~'.id',
                    'text': 'mautic.core.id',
                    'default': true
                }) }}
            </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {{- include('@MauticCore/Helper/list_actions.html.twig', { 'item': item }) -}}
                        </td>
                        <td class="col-custom-status">{{ include('@CustomObjects/Common/_status_badge.html.twig', { 'item': item }) }}</td>
                        <td>
                            <div>
                                {{- include('@MauticCore/Helper/publishstatus_icon.html.twig',
                                    {'item' : item, 'model' : 'custom.object'}) -}}
                                {# A plain click shows the object's fields in the shared modal; ctrl/cmd/shift click opens the full page. #}
                                <a href="{{ path(routeView, {'objectId': item.id}) }}"
                                   class="custom-object-name-link"
                                   data-details-url="{{ path(routeDetails, {'objectId': item.id}) }}"
                                   data-header="{{ item.name }} (#{{ item.id }})"
                                   onclick="if(event.button||event.ctrlKey||event.metaKey||event.shiftKey){return true;}var el=document.createElement('a');el.setAttribute('href',this.getAttribute('data-details-url'));el.setAttribute('data-toggle','ajaxmodal');el.setAttribute('data-target','#MauticSharedModal');el.setAttribute('data-header',this.getAttribute('data-header'));Mautic.ajaxifyModal(el,event);return false;">
                                    {{ item.name }}
                                </a>
                            </div>
                            {% if item.description %}
                                <div class="text-muted mt-4">
                                    <small>{{ item.description|purify }}</small>
                                </div>
                            {% endif %}
                        </td>
                        <td class="visible-md visible-lg">{{ item.id }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="panel-footer">
        {{ include('@MauticCore/Helper/pagination.html.twig', {
            'totalItems': count,
            'page': page,
            'limit': limit,
            'baseUrl': path(routeList),
            'sessionVar': sessionVar,
            'routeBase': routeList,
        }) }}
    </div>
{% else %}
    {{ include('@MauticCore/Helper/noresults.html.twig', {'tip': 'custom.object.noresults.tip'}) }}
{% endif %}
