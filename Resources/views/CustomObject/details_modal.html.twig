{#
  Body of the modal opened by a click on an object's name in the list: the tabs Campos (the fields table, _fields_table.html.twig, whose
  cells break long texts instead of pushing the table out of the modal) and Clonar (the definition as JSON, read only), then the footer
  (Editar only with permission, Detalhes, Fechar: a .bottom-form-buttons block that core copies into the modal footer, with a single
  .btn-primary like the contact modal). The shared modal is narrow by default, so only a modal holding this body is widened (:has);
  every other use of the shared modal keeps its size.
#}
<style>
    .modal-dialog:has(.custom-object-details-modal) {
        width: 1100px;
        max-width: 95vw;
    }
</style>
<div class="custom-object-details-modal">
    <ul class="nav nav-tabs nav-tabs-contained" role="tablist">
        <li class="active">
            <a href="#custom-object-modal-fields" data-toggle="tab">{{ 'custom.object.tab.fields'|trans }}</a>
        </li>
        <li id="definition-tab">
            <a href="#custom-object-modal-definition" data-toggle="tab">{{ 'custom.object.definition.tab'|trans }}</a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade in active bdr-w-0" id="custom-object-modal-fields">
            {{ include('@CustomObjects/CustomObject/_fields_table.html.twig') }}
        </div>
        <div class="tab-pane fade bdr-w-0" id="custom-object-modal-definition">
            {{ include('@CustomObjects/CustomObject/_definition.html.twig') }}
        </div>
    </div>
    <div class="bottom-form-buttons">
        {% if canEdit %}
        <button type="button" id="custom-object-details-edit" class="btn btn-primary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_custom_object_edit', {'objectId': customObject.getId()})|e('js') }}');">{{ 'mautic.core.form.edit'|trans }}<i class="ri-edit-line"></i></button>
        {% endif %}
        <button type="button" id="custom-object-details-page" class="btn btn-secondary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_custom_object_view', {'objectId': customObject.getId()})|e('js') }}');">{{ 'mautic.core.details'|trans }}<i class="ri-information-line"></i></button>
        <button type="button" id="custom-object-details-close" class="btn btn-tertiary btn-cancel" data-dismiss="modal">{{ 'mautic.core.close'|trans }}<i class="ri-close-line"></i></button>
    </div>
</div>
