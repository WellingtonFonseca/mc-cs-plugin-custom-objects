{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}customObject{% endblock %}

{% block headerTitle %}{{ 'custom.object.import.title'|trans }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="box-layout">
        <div class="col-md-9 bg-auto height-auto bg-white">
            <div class="pa-md">
                <p class="help-block">{{ (checkAlerts is not empty ? 'custom.object.import.preview_help' : 'custom.object.import.help')|trans }}</p>
                {% for alert in checkAlerts|default([]) %}
                    <div class="alert alert-{{ alert.type }} custom-object-import-check mb-sm" role="alert">
                        <div>
                            {{ alert.message }}
                            {% if alert.items is not empty %}
                                <ul class="mb-0">
                                    {% for item in alert.items %}<li>{{ item }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
                {% if errors is not empty %}
                    <div class="alert alert-danger" id="custom-object-import-errors">
                        <ul class="mb-0">
                            {% for error in errors %}<li>{{ error }}</li>{% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {{ form_row(form.definition) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
