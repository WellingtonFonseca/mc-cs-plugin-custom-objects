{#
  Body of the modal opened by a click on an item's name in a list: the field values (the same rows as the item page)
  and the contacts linked to the item, then the footer (Editar only with permission, Detalhes, Fechar: a .bottom-form-buttons block that core copies into the modal footer, with a single .btn-primary like the contact modal). The shared modal is narrow by default, so only a modal holding this body is
  widened (:has); every other use of the shared modal keeps its size. A long text with no spaces (a URL, a code) breaks
  inside the cell instead of pushing the table out of the modal.
#}
<style>
    .modal-dialog:has(.custom-item-details-modal) {
        width: 1100px;
        max-width: 95vw;
    }
    .custom-item-details-modal td,
    .custom-item-details-modal th {
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .custom-item-details-modal th {
        width: 25%;
    }
</style>
<div class="custom-item-details-modal">
    <div class="panel shd-none mb-md">
        <table class="table table-bordered table-striped mb-0">
            <tbody>
            {% for fieldValue in item.getCustomFieldValues() %}
                <tr>
                    <th>{{ fieldValue.getCustomField().getLabel()|escape }}</th>
                    <td>
                        {{ include('@CustomObjects/CustomField/value.html.twig', { fieldValue: fieldValue }) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if contactCount > 0 %}
        <h5 class="fw-sb mt-lg mb-md">{{ 'mautic.lead.leads'|trans }} ({{ contactCount }})</h5>
        <div class="panel shd-none mb-0 custom-item-details-contacts">
            <table class="table table-bordered table-striped mb-0">
                <tbody>
                {% for contact in contacts %}
                    <tr>
                        <td>
                            <a href="{{ path('mautic_contact_action', {'objectAction': 'view', 'objectId': contact.id}) }}" target="_blank" rel="noopener">
                                {{ (contact.firstname ~ ' ' ~ contact.lastname)|trim ?: contact.email }}
                            </a>
                        </td>
                        <td>{{ contact.email }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% if contactCount > contacts|length %}
                <div class="panel-footer text-muted">{{ contacts|length }} / {{ contactCount }}</div>
            {% endif %}
        </div>
    {% endif %}
    <div class="bottom-form-buttons">
        {% if canEdit %}
        <button type="button" id="custom-item-details-edit" class="btn btn-primary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_custom_item_edit', {'objectId': item.getCustomObject().getId(), 'itemId': item.getId()})|e('js') }}');">{{ 'mautic.core.form.edit'|trans }}<i class="ri-edit-line"></i></button>
        {% endif %}
        <button type="button" id="custom-item-details-page" class="btn btn-secondary" onclick="mQuery('#MauticSharedModal').modal('hide'); Mautic.loadContent('{{ path('mautic_custom_item_view', {'objectId': item.getCustomObject().getId(), 'itemId': item.getId()})|e('js') }}');">{{ 'mautic.core.details'|trans }}<i class="ri-file-list-line"></i></button>
        <button type="button" id="custom-item-details-close" class="btn btn-tertiary btn-cancel" data-dismiss="modal">{{ 'mautic.core.close'|trans }}<i class="ri-close-line"></i></button>
    </div>
</div>
