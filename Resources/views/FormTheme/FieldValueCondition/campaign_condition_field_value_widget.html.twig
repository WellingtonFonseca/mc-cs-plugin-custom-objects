{#
  The campaign condition "<object> field value": the first criterion (field, operator, value) and the additional ones.
  The item has to satisfy ALL of them on the SAME item. The rows are added and removed by custom-objects.js.
#}
{% macro criterion(row) %}
    <div class="row co-criterion" style="margin-bottom: 5px;">
        <div class="col-xs-4">{{ form_widget(row.field) }}</div>
        <div class="col-xs-3">{{ form_widget(row.operator) }}</div>
        <div class="col-xs-5">
            {# The remove control is the addon at the end of the value (core's input-group, like the "open image" of the HSM cards):
               the three columns fill the whole row, so every field reaches the right edge. #}
            <div class="input-group">
                {{ form_widget(row.value) }}
                <span class="input-group-addon co-criterion-remove" style="cursor: pointer;" title="{{ 'custom.item.criterion.remove'|trans }}" onclick="CustomObjects.removeCriterion(this)"><i class="ri-close-line"></i></span>
            </div>
        </div>
    </div>
{% endmacro %}

{% block _campaignevent_properties_row %}
    {% import _self as co %}
    <div id="co-criteria" data-index="{{ form.additionalCriteria|length }}" data-prototype="{{ co.criterion(form.additionalCriteria.vars.prototype)|e('html_attr') }}">
        <div class="row co-criterion" style="margin-bottom: 5px;">
            <div class="col-xs-4">{{ form_label(form.field) }}{{ form_widget(form.field) }}</div>
            <div class="col-xs-3">{{ form_label(form.operator) }}{{ form_widget(form.operator) }}</div>
            <div class="col-xs-5">{{ form_label(form.value) }}{{ form_widget(form.value) }}</div>
        </div>
        <div id="co-criteria-extra">
            {% for row in form.additionalCriteria %}
                {{ co.criterion(row) }}
            {% endfor %}
        </div>
    </div>
    <p class="help-block">{{ 'custom.item.criterion.same_item_help'|trans }}</p>
    <a href="javascript:void(0);" class="btn btn-tertiary btn-sm btn-add-item btn-nospin" onclick="CustomObjects.addCriterion()"><i class="ri-add-line"></i> {{ 'custom.item.criterion.add'|trans }}</a>
    {{ form_widget(form.customObjectId) }}
    <script>CustomObjects.initCustomFieldConditions();</script>
{% endblock %}
